[Unit]
Description=rqbit tunnel managed server
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
ExecStart=/opt/rqbit-tunnel/rqbit-tunnel server run --config /etc/rqbit-tunnel/server.json
Restart=on-failure
RestartSec=3
RuntimeDirectory=rqbit-tunnel
RuntimeDirectoryMode=0750
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/rqbit-tunnel /var/lib/rqbit-tunnel /run/rqbit-tunnel
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
